{
  "name": "video-studio",
  "version": "1.0.4",
  "description": "Sibcut Video Editor: a professional multi-track video editor. Timeline editing, text, effects, transitions, filters, keyframes, captions and export, stored locally on your device.",
  "type": "module",
  "private": true,
  "author": "Sina Sinaei <sina9100t@gmail.com>",
  "homepage": "https://github.com/officialsinasinaei/Sibcut-Video-Editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/officialsinasinaei/Sibcut-Video-Editor.git"
  },
  "bugs": {
    "url": "https://github.com/officialsinasinaei/Sibcut-Video-Editor/issues"
  },
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.12"
  },
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "npm run build:worker && vite",
    "build": "npm run build:worker && vite build",
    "build:worker": "vite build --config vite.worker.config.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:wasm": "node tools/build-wasm.mjs",
    "check:licenses": "node tools/check-licenses.mjs",
    "check:packaging": "node tools/check-packaging.mjs",
    "prebuild": "node tools/fetch-native-vosk.mjs && npm run check:licenses && npm run check:packaging",
    "build:electron": "node tools/fetch-native-vosk.mjs && npm run check:packaging && npm run build:worker && vite build --config vite.electron.config.js",
    "electron:dev": "npm run build:electron && electron .",
    "electron:pack": "npm run build:electron && electron-builder --win",
    "electron:pack:portable": "npm run build:electron && electron-builder --win portable",
    "electron:pack:portable:zip": "npm run build:electron && electron-builder --win zip",
    "electron:pack:zip": "npm run build:electron && electron-builder --win zip",
    "electron:pack:installer": "npm run build:electron && electron-builder --win nsis",
    "electron:pack:mac": "npm run build:electron && electron-builder --mac",
    "electron:pack:mac:arm64": "npm run build:electron && electron-builder --mac --arm64",
    "electron:pack:mac:x64": "npm run build:electron && electron-builder --mac --x64",
    "electron:pack:linux": "npm run build:electron && electron-builder --linux",
    "fetch:vosk": "node tools/fetch-native-vosk.mjs"
  },
  "dependencies": {
    "koffi": "^3.3.4",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/anton": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/dancing-script": "5.3.0",
    "@fontsource/estedad": "^5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/lalezar": "^5.3.0",
    "@fontsource/lobster": "5.3.0",
    "@fontsource/merriweather": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/pacifico": "5.3.0",
    "@fontsource/permanent-marker": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "axe-core": "4.14.0",
    "electron": "36.4.0",
    "electron-builder": "26.0.12",
    "gandom-font": "^0.8.0",
    "jsdom": "30.1.2",
    "lucide": "1.54.0",
    "mediabunny": "1.61.3",
    "onnxruntime-web": "^1.31.1",
    "parastoo-font": "^2.0.1",
    "sahel-font": "^3.4.0",
    "samim-font": "^4.0.5",
    "shabnam-font": "^5.0.0",
    "tanha-font": "^0.10.0",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "com.sinasinaei.sibcutvideoeditor",
    "productName": "Sibcut Video Editor",
    "executableName": "Sibcut Video Editor",
    "copyright": "Copyright © 2026 Sina Sinaei",
    "compression": "normal",
    "asar": true,
    "asarUnpack": [
      "**/native/**",
      "**/node_modules/koffi/**",
      "**/node_modules/@koromix/**"
    ],
    "files": [
      "dist/**",
      "electron-main.cjs",
      "updater.cjs",
      "updater-ui.html",
      "preload.cjs",
      "vosk-service.cjs",
      "vosk-worker.cjs",
      "electron-vosk-ipc.cjs",
      "electron-projects-ipc.cjs",
      "assets/branding/app-icons/**",
      "assets/branding/master/app-icon-master.png",
      "assets/branding/tray/**",
      "build/icon.*",
      "build/icons/**"
    ],
    "extraResources": [],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "native/win-x86_64/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Sibcut Video Editor",
      "uninstallDisplayName": "Sibcut Video Editor",
      "artifactName": "Sibcut-Video-Editor-Setup.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user",
      "artifactName": "Sibcut-Video-Editor-Portable.exe",
      "unpackDirName": "SibcutVideoEditor",
      "splashImage": "build/splash.bmp",
      "useZip": true
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Sibcut-Video-Editor-macOS-${arch}.${ext}",
      "files": [
        "native/darwin/**"
      ]
    },
    "dmg": {
      "title": "Sibcut Video Editor",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "icon": "build/icons",
      "category": "Video",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "maintainer": "Sina Sinaei <sina9100t@gmail.com>",
      "synopsis": "Professional multi-track video editor",
      "description": "Sibcut Video Editor: a professional multi-track video editor with timeline editing, text, effects, transitions, filters, keyframes, captions and export, running locally on your device.",
      "files": [
        "native/linux-x64/**"
      ]
    },
    "appImage": {
      "artifactName": "Sibcut-Video-Editor-Linux-${arch}.AppImage"
    },
    "deb": {
      "artifactName": "Sibcut-Video-Editor-Linux-${arch}.deb"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "electronVersion": "36.4.0"
  }
}
